@echo off
setlocal
set "DX12_BACKEND_PROBE_ROOT=%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $root=$env:DX12_BACKEND_PROBE_ROOT; $exe=Join-Path $root 'Dx12BackendProbe.exe'; $dir=Join-Path $root ('backend-probe-results-'+(Get-Date -Format 'yyyyMMdd-HHmmss-fff')); try{New-Item -ItemType Directory -Path $dir | Out-Null}catch{$dir=Join-Path $env:TEMP ('Dx12BackendProbe-results-'+(Get-Date -Format 'yyyyMMdd-HHmmss-fff')); New-Item -ItemType Directory -Path $dir | Out-Null}; $report=Join-Path $dir 'launcher-result.txt'; $sha=[Security.Cryptography.SHA256]::Create(); try{$exeHash=[BitConverter]::ToString($sha.ComputeHash([IO.File]::ReadAllBytes($exe))).Replace('-','')}finally{$sha.Dispose()}; @(('Time: '+[DateTimeOffset]::Now.ToString('o')),('Executable: '+$exe),('Executable SHA256: '+$exeHash),('OS: '+[Environment]::OSVersion.ToString()),('64-bit OS: '+[Environment]::Is64BitOperatingSystem)) | Set-Content -LiteralPath $report -Encoding UTF8; Write-Host ('Running maintained MonoGame DX12 backend probe. Results: '+$dir); try{$si=New-Object Diagnostics.ProcessStartInfo; $si.FileName=$exe; $si.Arguments=[char]34+$dir+[char]34; $si.WorkingDirectory=$dir; $si.UseShellExecute=$false; $si.RedirectStandardOutput=$true; $si.RedirectStandardError=$true; $p=[Diagnostics.Process]::Start($si); ('PID: '+$p.Id) | Add-Content -LiteralPath $report; $out=[IO.File]::Create((Join-Path $dir 'stdout.txt')); $err=[IO.File]::Create((Join-Path $dir 'stderr.txt')); try{$outTask=$p.StandardOutput.BaseStream.CopyToAsync($out); $errTask=$p.StandardError.BaseStream.CopyToAsync($err); $timeout=!$p.WaitForExit(120000); if($timeout){$p.Kill(); $p.WaitForExit()}; [void]$outTask.GetAwaiter().GetResult(); [void]$errTask.GetAwaiter().GetResult(); $code=[int]$p.ExitCode}finally{$out.Dispose(); $err.Dispose(); $p.Dispose()}; $hex=[BitConverter]::ToUInt32([BitConverter]::GetBytes($code),0).ToString('X8'); @(('Timed out: '+$timeout),('Exit code: '+$code),('Exit hex: 0x'+$hex)) | Add-Content -LiteralPath $report; if(Test-Path -LiteralPath (Join-Path $dir 'result.txt')){Get-Content -LiteralPath (Join-Path $dir 'result.txt') -Encoding UTF8}; Get-Content -LiteralPath $report; Write-Host 'Return the complete backend-probe-results folder.'; if($timeout){exit 3}; exit $code}catch{('Launcher error: '+$_.Exception.ToString()) | Add-Content -LiteralPath $report; Get-Content -LiteralPath $report; exit 2}"
set "DX12_BACKEND_PROBE_EXIT=%errorlevel%"
if /I not "%~1"=="/nopause" pause
exit /b %DX12_BACKEND_PROBE_EXIT%
