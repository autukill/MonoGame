<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>netstandard2.1</TargetFramework><IncludeBuildOutput>false</IncludeBuildOutput><IsPackable>true</IsPackable>
  <PackageId>MyGameEngine.MonoGame.Runtime.Windows.DX12</PackageId><PackageVersion>3.8.6-mge.3</PackageVersion>
  <Authors>MyGameEngine</Authors><Description>MyGameEngine-maintained Windows x64 DX12 runtime with BC7 support. Requires MyGameEngine.MonoGame.Framework.Native 3.8.6-mge.3. Unofficial MonoGame maintenance release.</Description>
  <PackageLicenseExpression>MS-PL</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile>
  <RepositoryUrl>https://github.com/autukill/MonoGame</RepositoryUrl><PackageProjectUrl>https://github.com/autukill/MonoGame/tree/mge/3.8.6</PackageProjectUrl><RepositoryType>git</RepositoryType><RepositoryCommit>$(MgeSourceCommit)</RepositoryCommit><PackageTags>MonoGame;MyGameEngine;DX12;Windows;native</PackageTags>
  <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking><EnableDefaultItems>false</EnableDefaultItems>
 </PropertyGroup>
 <ItemGroup>
  <None Include="README.md" Pack="true" PackagePath="/"/>
  <None Include="$(MgePayload)/mgruntime.dll" Pack="true" PackagePath="runtimes/win-x64/native/"/>
  <None Include="$(MgePayload)/provenance.json" Pack="true" PackagePath="/"/>
  <None Include="$(MgePayload)/licenses/**/*" Pack="true" PackagePath="licenses/%(RecursiveDir)"/>
  <None Include="$(MgePayload)/MyGameEngine.MonoGame.Runtime.Windows.DX12.targets" Pack="true" PackagePath="buildTransitive/"/>
  <None Include="../docs/*.md" Pack="true" PackagePath="docs/"/>
 </ItemGroup>
</Project>
