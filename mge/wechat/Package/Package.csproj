<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><EnableDefaultItems>false</EnableDefaultItems><IncludeBuildOutput>false</IncludeBuildOutput><IsPackable>true</IsPackable><SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
 <PackageId>MyGameEngine.MonoGame.Runtime.WeChat.WebGL2</PackageId><PackageVersion>3.8.6-mge.2-astc.5</PackageVersion><Authors>MyGameEngine</Authors><Description>Unofficial MonoGame 3.8.6 WeChat mini-game WebGL2 backend. Matching Framework, native runtime, 2D audio and export tools in one package. Windows x64 build host; Android/iOS WeChat targets.</Description><PackageLicenseExpression>MS-PL</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile><RepositoryUrl>https://github.com/autukill/MonoGame</RepositoryUrl><RepositoryCommit>$(MgeSourceCommit)</RepositoryCommit><RepositoryType>git</RepositoryType></PropertyGroup>
 <ItemGroup>
  <None Include="$(MgePayload)/MonoGame.Framework.dll" Pack="true" PackagePath="lib/netstandard2.1/"/>
  <None Include="$(MgePayload)/MonoGame.Framework.xml" Pack="true" PackagePath="lib/netstandard2.1/"/>
  <None Include="$(MgePayload)/native/*.a" Pack="true" PackagePath="runtimes/browser-wasm/native/"/>
  <None Include="../*.props;../*.targets;../WeChatGame.cs" Pack="true" PackagePath="buildTransitive/"/>
  <None Include="../Host/**/*" Pack="true" PackagePath="Host/"/>
  <None Include="../Tools/*" Pack="true" PackagePath="tools/"/>
  <None Include="$(MgePayload)/tools/*" Pack="true" PackagePath="tools/"/>
  <None Include="$(MgePayload)/licenses/**/*" Pack="true" PackagePath="licenses/"/>
  <None Include="../README.md" Pack="true" PackagePath="/"/>
  <None Include="$(MgePayload)/provenance.json" Pack="true" PackagePath="/"/>
 </ItemGroup>
</Project>
