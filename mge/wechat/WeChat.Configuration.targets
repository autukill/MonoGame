<Project>
 <PropertyGroup Condition="'$(MonoGameWeChat)'=='true'">
  <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible>
 </PropertyGroup>
 <PropertyGroup Condition="'$(MonoGameWeChat)'=='true' And '$(OutputType)'=='Exe'">
  <PublishTrimmed>true</PublishTrimmed><SelfContained>true</SelfContained><UseAppHost>false</UseAppHost><InvariantGlobalization>true</InvariantGlobalization>
  <IlcSingleThreaded>true</IlcSingleThreaded><WasmEnableThreads>false</WasmEnableThreads><WasmEnableSIMD>true</WasmEnableSIMD><WasmEnableExceptionHandling>false</WasmEnableExceptionHandling><IlcLlvmExceptionHandlingModel>cpp</IlcLlvmExceptionHandlingModel><DotNetJsApi>true</DotNetJsApi>
  <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver><IlcPgoOptimize>false</IlcPgoOptimize>
  <EmccExtraLDFlags>$(EmccExtraLDFlags) -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sERROR_ON_UNDEFINED_SYMBOLS=1</EmccExtraLDFlags>
  <MonoGameWeChatNodePath Condition="'$(MonoGameWeChatNodePath)'==''">node</MonoGameWeChatNodePath>
  <MonoGameWeChatConfiguration Condition="'$(MonoGameWeChatConfiguration)'==''">$(MSBuildProjectDirectory)/wechat.json</MonoGameWeChatConfiguration>
 </PropertyGroup>
 <ItemGroup Condition="'$(MonoGameWeChat)'=='true' And '$(OutputType)'=='Exe'">
  <Compile Include="$(MSBuildThisFileDirectory)WeChatGame.cs" Link="MonoGame/WeChat/WeChatGame.cs" />
  <NativeLibrary Include="$(MSBuildThisFileDirectory)../runtimes/browser-wasm/native/mgruntime.a;$(MSBuildThisFileDirectory)../runtimes/browser-wasm/native/libSDL2.a" />
  <DirectPInvoke Include="mgruntime;__Internal" />
  <EmccExportedFunction Include="_MGP_Web_NotifyFocusChange;_MGP_Web_NotifyCanvasResize;_MGP_Web_SetCanvasResizeManaged" />
 </ItemGroup>
</Project>
